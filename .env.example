# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the browser. Used for signup + creating Pasabuyer accounts.
SUPABASE_SERVICE_ROLE_KEY=

# Python Mercari scraper service (see scraper/)
SCRAPER_URL=http://127.0.0.1:8001
# Shared secret between Next.js and the scraper. Use a long random string.
SCRAPER_SECRET=change-me

# Set to "false" to disable public Owner/company signup
ALLOW_SIGNUP=true
